save_button.pack(side="right")

# =====================================
# Statusleiste
# =====================================

status_var = tk.StringVar()
status_var.set("Bereit")

status_bar = tk.Label(
    app,
    textvariable=status_var,
    bg="#1f4e78",
    fg="white",
    anchor="w",
    padx=10,
    pady=4
