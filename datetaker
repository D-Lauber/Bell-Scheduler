new_folder_button.pack(
    side="left",
    padx=(0, 10)
)

filename_entry = ttk.Entry(
    save_row,
    font=("Segoe UI", 11)
)

filename_entry.pack(
    side="left",
    fill="x",
    expand=True,
    padx=(0, 10)
