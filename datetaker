import tkinter as tk
from tkinter import ttk, messagebox
import json
import re
import os
from tkinter import simpledialog

# =====================================
# Daten
# =====================================

timestamps = []

BASE_DIR = "Sets"

os.makedirs(BASE_DIR, exist_ok=True)

# =====================================
# Funktionen
# =====================================

def is_valid_time(time_string):
    pattern = r"^\d{2}:\d{2}$"

    if re.match(pattern, time_string):
        try:
            hour, minute = map(int, time_string.split(":"))
            return 0 <= hour < 24 and 0 <= minute < 60
        except ValueError:
            return False

    return False


def refresh_tree():

    tree.delete(*tree.get_children())

    timestamps.sort()

    for index, timestamp in enumerate(timestamps):

        tag = "evenrow" if index % 2 == 0 else "oddrow"

        tree.insert(
            "",
            tk.END,
            values=(timestamp,),
            tags=(tag,)
        )


def add_timestamp():

    timestamp = entry.get().strip()

    if is_valid_time(timestamp):

        timestamps.append(timestamp)

        refresh_tree()

        entry.delete(0, tk.END)

        status_var.set(f"🔔 Läutzeit {timestamp} hinzugefügt")

    else:

        messagebox.showerror(
            "Ungültige Uhrzeit",
            "Bitte eine Uhrzeit im Format HH:MM eingeben."
        )


def remove_selected():

    selected = tree.selection()

    if not selected:
        return

    for item in selected:

        value = tree.item(item)["values"][0]

        if value in timestamps:
            timestamps.remove(value)

    refresh_tree()

    status_var.set("Läutzeit entfernt")


def save_to_json():
    filename = filename_entry.get().strip()

    if not filename:
        messagebox.showerror(
            "Fehler",
            "Bitte einen Namen für das Set eingeben."
        )
        return

    selected_folder = folder_var.get()

    if not selected_folder:
        messagebox.showerror(
            "Fehler",
            "Bitte einen Ordner auswählen."
        )
        return

    if not filename.endswith(".json"):
        filename += ".json"

    timestamps.sort()

    full_path = os.path.join(
        BASE_DIR,
        selected_folder,
        filename
    )

    with open(full_path, "w", encoding="utf-8") as file:
        json.dump(
            timestamps,
            file,
            indent=4
        )

    status_var.set(f"💾 Gespeichert: {full_path}")

    messagebox.showinfo(
        "Erfolg",
        f"Das Set wurde gespeichert:\n\n{full_path}"
    )

def create_folder():

    name = simpledialog.askstring(
        "Neuer Ordner",
        "Name des neuen Ordners:"
    )

    if not name:
        return

    os.makedirs(
        os.path.join(BASE_DIR, name),
        exist_ok=True
    )

    folder_select["values"] = get_subfolders()

    folder_var.set(name)

    status_var.set(f"📁 Ordner '{name}' erstellt")


def get_subfolders():
    return [
        folder
        for folder in os.listdir(BASE_DIR)
        if os.path.isdir(os.path.join(BASE_DIR, folder))
    ]

